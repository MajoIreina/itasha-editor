# NEXT build outputs, downloaded dependencies and local reports
node_modules/
/next/target/
/next/src-tauri/target/
/next/src-tauri/gen/
/next/dist/
/next/.local-data/
/next/.reports/
**/_scratch/
__pycache__/
*.pyc
*.log
*.exe
*.dll
*.pdb
*.obj
*.zip
*.7z
*.pending
*.blend
*.blend1
*.glb
*.gltf

# Frozen legacy source/runtime and machine data remain local
/app/
/backend/
/desktop/
/resources/
/examples/
/development/
/runtime/
/app-deps/
/projects/
/exports/
/logs/
/app-data*/
/webview2-data/
/webview2-test-data/
/NVIDIA Corporation/
/.studio-server
/.itasha-session.json
/performance-settings.json
/启动错误.txt
/关闭后台服务.cmd
/关闭后台服务.ps1
/tools/*
!/tools/git-auto-sync.ps1

# Retain only catalog source data from the old registry
/config/*
!/config/vehicles.json
/vehicles/*
!/vehicles/README.md
!/vehicles/*/
/vehicles/*/*
!/vehicles/*/backend-adapter.json

# Paint history, unsealed maps and previews stay local.
# Current runtime map, compatibility fixture and layout dimensions are versioned.
/next/assets/paint/*
!/next/assets/paint/README.md
!/next/assets/paint/manifest.json
!/next/assets/paint/su7-v24-mirrored/
/next/assets/paint/su7-v24-mirrored/*
!/next/assets/paint/su7-v24-mirrored/paint-map.json
!/next/assets/paint/su7-v24-mirrored/build-report.json
!/next/assets/paint/su7-v24-mirrored/README.md
!/next/assets/paint/su7-v21-classified-only/
/next/assets/paint/su7-v21-classified-only/*
!/next/assets/paint/su7-v21-classified-only/paint-map.json
!/next/assets/paint/su7-v21-classified-only/build-report.json
!/next/assets/paint/su7-v15-charge-cover/
/next/assets/paint/su7-v15-charge-cover/*
!/next/assets/paint/su7-v15-charge-cover/compact-report.json

.env
.env.*
!.env.example
*.pem
*.key
Thumbs.db
.DS_Store
